# Deploy environment example
# Copy this file to `deploy/.env` before running `docker compose up -d`.

# Core passwords
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
REDIS_PASSWORD=change_me_redis_password
RABBITMQ_ADMIN_PASSWORD=change_me_rabbitmq_admin_password
RABBITMQ_PRODUCER_PASSWORD=change_me_rabbitmq_producer_password
RABBITMQ_CONSUMER_PASSWORD=change_me_rabbitmq_consumer_password

# Nacos auth
NACOS_AUTH_TOKEN=replace_with_a_random_base64_token
NACOS_AUTH_IDENTITY_KEY=nacos.identity
NACOS_AUTH_IDENTITY_VALUE=change_me_nacos_identity_value
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# JMeter host paths mounted into the container
JMETER_HOME=/opt/apache-jmeter-5.6.3
JMETER_RESULTS_DIR=/opt/apache-jmeter-5.6.3/results
JMETER_SCRIPTS_DIR=/opt/apache-jmeter-5.6.3/scripts

# Time zone
TZ=Asia/Shanghai

# AI (optional, fallback works without a real key)
ARK_API_KEY=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_COMPLETIONS_PATH=/chat/completions
AI_MODEL=ep-your-model-id
AI_PROVIDER=fallback
